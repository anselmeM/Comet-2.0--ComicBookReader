// Comet — Prisma Schema
// Run: npx prisma db push (dev) | npx prisma migrate deploy (prod)
//
// DATABASE CONFIGURATION:
// - Development: Uses SQLite (file:./dev.db)
// - Production: Use PostgreSQL (set DATABASE_URL in .env)
//
// To switch to PostgreSQL:
// 1. Update your .env with DATABASE_URL for PostgreSQL
// 2. Change provider below to "postgresql"
// 3. Run: npx prisma db push (for new DB) or npx prisma migrate

generator client {
  provider = "prisma-client-js"
}

// Use environment variable for database URL (supports both SQLite and PostgreSQL)
datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// NOTE: For PostgreSQL in production, change the datasource to:
// datasource db {
//   provider  = "postgresql"
//   url       = env("DATABASE_URL")
// }

// ────────────────────────────────────────────────────
// AUTH (Auth.js v5 required models)
// ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  resetToken    String?   // Password reset token
  resetTokenExpiry DateTime? // Password reset token expiry
  image         String?
  plan          String    @default("FREE")
  hasCompletedOnboarding Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  library   Comic[]
  progress  ReadingProgress[]
  bookmarks Bookmark[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}



// ────────────────────────────────────────────────────
// LIBRARY
// ────────────────────────────────────────────────────

model Comic {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  filehash    String    // SHA-256 of the file (dedup key)
  pageCount   Int
  coverUrl    String?   // Blob ObjectURL or remote CDN URL
  comicVineId String?   // External metadata reference
  series      String?
  issue       Int?
  year        Int?
  metadata    String?   // Raw ComicVine enrichment payload
  
  // New fields for enhanced library features
  isFavorite  Boolean   @default(false)  // Quick access favorites
  rating      Int       @default(0)      // 0-5 stars
  tags        String?   // JSON array: ["Marvel", "Spider-Man"]

  addedAt     DateTime  @default(now())
  lastReadAt  DateTime?

  progress    ReadingProgress?

  @@unique([userId, filehash]) // Prevent duplicate uploads per user
  @@index([userId])
  @@index([filehash])
  @@index([userId, lastReadAt]) // Efficient "Continue Reading" queries
  @@index([userId, series])     // For series grouping queries
}

model ReadingProgress {
  id          String     @id @default(cuid())
  userId      String
  comicId     String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic       Comic      @relation(fields: [comicId], references: [id], onDelete: Cascade)

  lastPage    Int        @default(0)
  totalPages  Int
  zoomLevel   Float      @default(1.0)
  readStatus  String     @default("UNREAD")
  updatedAt   DateTime   @updatedAt

  bookmarks   Bookmark[]

  @@index([userId])
  @@index([userId, readStatus])
}

model Bookmark {
  id          String          @id @default(cuid())
  userId      String
  comicId     String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic       ReadingProgress @relation(fields: [comicId], references: [comicId], onDelete: Cascade)

  pageNumber  Int
  label       String?         // Optional user-defined label/notes
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, comicId, pageNumber]) // One bookmark per page per comic per user
  @@index([userId])
  @@index([comicId])
}


