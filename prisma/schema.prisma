generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(cuid())
  name                   String?
  email                  String            @unique
  emailVerified          DateTime?
  password               String?
  resetToken             String?
  resetTokenExpiry       DateTime?
  image                  String?
  plan                   String            @default("FREE")
  hasCompletedOnboarding Boolean           @default(false)
  defaultReadingMode     String            @default("single-page")
  theme                  String            @default("dark")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  accounts               Account[]
  bookmarks              Bookmark[]
  library                Comic[]
  progress               ReadingProgress[]
  sessions               Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Comic {
  id          String           @id @default(cuid())
  userId      String
  title       String
  filehash    String
  pageCount   Int
  coverUrl    String?
  comicVineId String?
  series      String?
  issue       Int?
  year        Int?
  metadata    String?
  isFavorite  Boolean          @default(false)
  rating      Int              @default(0)
  tags        String?
  addedAt     DateTime         @default(now())
  lastReadAt  DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress    ReadingProgress?

  @@unique([userId, filehash])
  @@index([userId])
  @@index([filehash])
  @@index([userId, lastReadAt])
  @@index([userId, series])
}

model ReadingProgress {
  id         String     @id @default(cuid())
  userId     String
  comicId    String     @unique
  lastPage   Int        @default(0)
  totalPages Int
  zoomLevel  Float      @default(1.0)
  readStatus String     @default("UNREAD")
  updatedAt  DateTime   @updatedAt
  bookmarks  Bookmark[]
  comic      Comic      @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readStatus])
}

model Bookmark {
  id         String          @id @default(cuid())
  userId     String
  comicId    String
  pageNumber Int
  label      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  comic      ReadingProgress @relation(fields: [comicId], references: [comicId], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId, pageNumber])
  @@index([userId])
  @@index([comicId])
}
