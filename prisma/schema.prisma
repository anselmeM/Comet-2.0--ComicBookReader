generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

model User {
  id                     String            @id @default(cuid())
  name                   String?
  email                  String            @unique
  emailVerified          DateTime?
  password               String?
  resetToken             String?
  resetTokenExpiry       DateTime?
  image                  String?
  role                   String            @default("USER")
  plan                   String            @default("FREE")

  hasCompletedOnboarding Boolean           @default(false)
  defaultReadingMode     String            @default("single-page")
  theme                  String            @default("dark")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  failedAttempts         Int               @default(0)
  lockoutUntil           DateTime?
  readingStreak          Int               @default(0)
  lastReadDate           DateTime?

  // Stripe Billing
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  accounts               Account[]
  bookmarks              Bookmark[]
  library                Comic[]
  progress               ReadingProgress[]
  sessions               Session[]
  collections            Collection[]
  friendships            Friendship[]      @relation("UserFriends")
  friendsOf              Friendship[]      @relation("FriendToUser")
  sentRequests           FriendRequest[]   @relation("SentRequests")
  receivedRequests       FriendRequest[]   @relation("ReceivedRequests")
  notifications          Notification[]    @relation("UserNotifications")
  sentInvitations        Invitation[]      @relation("SentInvitations")
  readingSessions        ReadingSession[]
  activityReactions      ActivityReaction[]
  comicComments          ComicComment[]
  badges                 UserBadge[]
  sentMessages           DirectMessage[]   @relation("SentMessages")
  receivedMessages       DirectMessage[]   @relation("ReceivedMessages")

  @@index([email])
}

model Invitation {
  id        String   @id @default(cuid())
  senderId  String
  email     String
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())
  sender    User     @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // FRIEND_REQUEST_ACCEPTED, NEW_MESSAGE, CONTENT_LIKE, CONTENT_COMMENT, NEW_CONTENT, SYSTEM_ALERT
  title     String
  message   String
  link      String?  // Optional link to navigate to (e.g., friend's profile or new content)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendToUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  sender     User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Comic {
  id          String            @id @default(cuid())
  userId      String
  title       String
  filehash    String
  sizeBytes   Int              @default(0)
  pageCount   Int
  coverUrl    String?
  comicVineId String?
  series      String?
  issue       Int?
  year        Int?
  isFavorite  Boolean          @default(false)
  rating      Int              @default(0)
  tags        String?
  metadata    String?
  addedAt     DateTime         @default(now())
  lastReadAt  DateTime?

  // Cloud Sync
  storageKey  String?          @unique
  syncStatus  String           @default("LOCAL") // LOCAL, PENDING, SYNCED, ERROR

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress        ReadingProgress?
  collections     CollectionItem[]
  bookmarks       Bookmark[]
  readingSessions ReadingSession[]
  comicComments   ComicComment[]

  @@unique([userId, filehash])
  @@index([userId])
  @@index([filehash])
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  comicId    String   @unique
  lastPage   Int      @default(0)
  totalPages Int
  zoomLevel  Float    @default(1.0)
  readStatus     String   @default("UNREAD") // UNREAD, READING, COMPLETED
  totalTimeSpent Int      @default(0) // Seconds
  lastReadAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt


  comic     Comic              @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions ActivityReaction[]

  @@unique([userId, comicId])
  @@index([userId])
  @@index([comicId])
}

model Collection {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@unique([userId, name])
  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  comicId      String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  comic      Comic      @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([collectionId, comicId])
  @@index([collectionId])
  @@index([comicId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  comicId    String
  pageNumber Int
  label      String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId, pageNumber])
  @@index([userId])
  @@index([comicId])
}

model ReadingSession {
  id              String   @id @default(cuid())
  userId          String
  comicId         String
  pagesRead       Int      @default(0)
  durationSeconds Int      @default(0)
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([comicId])
  @@index([createdAt])
}

model ActivityReaction {
  id                String   @id @default(cuid())
  readingProgressId String
  userId            String
  reactionType      String   // FIRE, HEART, LIKE, TROPHY
  createdAt         DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingProgress ReadingProgress @relation(fields: [readingProgressId], references: [id], onDelete: Cascade)

  @@unique([readingProgressId, userId, reactionType])
  @@index([readingProgressId])
  @@index([userId])
}

model ComicComment {
  id        String   @id @default(cuid())
  comicId   String
  userId    String
  message   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic Comic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@index([comicId])
  @@index([userId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
}
