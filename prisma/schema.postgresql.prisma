// Comet — Prisma Schema for PostgreSQL (Production)
// This file is used for PostgreSQL deployments (e.g., Vercel + Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Recommended for Neon/Supabase migrations
}

// ────────────────────────────────────────────────────
// AUTH (Auth.js v5 required models)
// ────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  resetToken    String?   @db.Text
  resetTokenExpiry DateTime?
  image         String?
  plan          String    @default("FREE")
  hasCompletedOnboarding Boolean @default(false)
  
  // Reading Preferences
  defaultReadingMode String   @default("single-page")
  theme              String   @default("dark")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  library   Comic[]
  progress  ReadingProgress[]
  bookmarks Bookmark[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}



// ────────────────────────────────────────────────────
// LIBRARY
// ────────────────────────────────────────────────────

model Comic {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  filehash    String    // SHA-256 of the file (dedup key)
  pageCount   Int
  coverUrl    String?   @db.Text
  comicVineId String?
  series      String?
  issue       Int?
  year        Int?
  metadata    String?   @db.Text // Raw ComicVine enrichment payload
  
  // Library Features
  isFavorite  Boolean   @default(false)
  rating      Int       @default(0)
  tags        String?   @db.Text // JSON string

  addedAt     DateTime  @default(now())
  lastReadAt  DateTime?

  progress    ReadingProgress?

  @@unique([userId, filehash])
  @@index([userId])
  @@index([filehash])
  @@index([userId, lastReadAt])
  @@index([userId, series])
}

model ReadingProgress {
  id          String     @id @default(cuid())
  userId      String
  comicId     String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic       Comic      @relation(fields: [comicId], references: [id], onDelete: Cascade)

  lastPage    Int        @default(0)
  totalPages  Int
  zoomLevel   Float      @default(1.0)
  readStatus  String     @default("UNREAD")
  updatedAt   DateTime   @updatedAt

  bookmarks   Bookmark[]

  @@index([userId])
  @@index([userId, readStatus])
}

model Bookmark {
  id          String          @id @default(cuid())
  userId      String
  comicId     String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic       ReadingProgress @relation(fields: [comicId], references: [comicId], onDelete: Cascade)

  pageNumber  Int
  label       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, comicId, pageNumber])
  @@index([userId])
  @@index([comicId])
}
