# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# markdown documentation files
*.md
!README.md
!AGENTS.md
!CONTRIBUTING.md
!.github/PULL_REQUEST_TEMPLATE.md

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright e2e artifacts
playwright-report/
test-results/
blob-report/

# mock storage & binaries
/prisma/mock-s3/
/scripts/test-comic.cbz

# local SQLite dev database (recreated by `npm run db:push`)
/prisma/prisma/dev.db
/prisma/prisma/dev.db-journal
/prisma/prisma/dev.db-shm
/prisma/prisma/dev.db-wal

