# Comet 2.0 — Environment Variables Example
# Copy this to .env.local for development or set in your production provider (Vercel, etc.)

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────────────────────

# Neon/Supabase PostgreSQL connection string
# Example: postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/comet"

# Direct connection to the database (used for migrations in some providers)
DIRECT_URL="postgresql://user:password@localhost:5432/comet"

# Migrations run automatically only on Vercel production (VERCEL_ENV=production).
# For a local/CI build that intentionally applies migrations, opt in explicitly:
# ALLOW_DB_MIGRATE="true"

# ──────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (Clerk)
# ──────────────────────────────────────────────────────────────────────────────
# Copy from https://dashboard.clerk.com → API Keys.
# NEVER commit real keys — set them in .env.local (dev) and Vercel (prod).

# Publishable key (public, NEXT_PUBLIC_ prefix is safe for client use)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Secret key (server-only — rotate immediately if ever exposed)
CLERK_SECRET_KEY="sk_test_..."

# Svix signing secret for the Clerk → /api/webhooks/clerk user-sync endpoint
# Clerk Dashboard → Webhooks → Add Endpoint → https://your-domain.com/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk hosted auth page URLs (used by middleware redirects)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/library"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding"

# Keyless mode. When the publishable key is absent the app runs without auth
# outside production (local dev, Playwright) instead of returning 500s. In a
# production runtime this only happens with an explicit opt-in, used by
# Lighthouse CI's ephemeral server. NEVER set this on a real deployment.
# ALLOW_KEYLESS_AUTH="true"

# ──────────────────────────────────────────────────────────────────────────────
# BILLING (Stripe)
# ──────────────────────────────────────────────────────────────────────────────
# Test keys for local dev; secret keys are server-only. Premium checkout is
# disabled (dev bypass) when these are absent.
STRIPE_SECRET_KEY="sk_test_..."
# Endpoint secret for /api/webhooks/stripe (Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Recurring Premium price ids (monthly / annual)
STRIPE_PREMIUM_PRICE_ID="price_..."
STRIPE_PREMIUM_PRICE_ID_ANNUAL="price_..."

# ──────────────────────────────────────────────────────────────────────────────
# EXTERNAL APIS
# ──────────────────────────────────────────────────────────────────────────────

# ComicVine API Key for metadata enrichment
# Register at: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY="your-comicvine-api-key"

# ──────────────────────────────────────────────────────────────────────────────
# EMAIL (SMTP) - For friend invitations
# ──────────────────────────────────────────────────────────────────────────────

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="\"Comet Reader\" <noreply@yourdomain.com>"

# ──────────────────────────────────────────────────────────────────────────────
# CACHING / RATE LIMITING (Upstash Redis)
# ──────────────────────────────────────────────────────────────────────────────
# Optional locally (per-process in-memory fallback), required in production:
# without these the library/profile limiters fail closed and caching degrades
# to per-instance memory.
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ──────────────────────────────────────────────────────────────────────────────
# MONITORING (Sentry)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn"

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ──────────────────────────────────────────────────────────────────────────────

# Public app URL for social sharing and absolute links
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Environment
NODE_ENV="development"

# ──────────────────────────────────────────────────────────────────────────────
# S3 / CLOUD STORAGE (e.g. AWS S3, Cloudflare R2, Backblaze B2)
# ──────────────────────────────────────────────────────────────────────────────
# These are required for production Cloud Sync. In development, the app
# automatically falls back to the mock S3 server if these are undefined.
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
AWS_REGION="auto"
AWS_BUCKET_NAME="comet-comics"

# Storage aliases — the AWS_* names take precedence when set; the STORAGE_*
# fallbacks let you point at a different bucket without renaming secrets
# (see src/lib/storage.ts).
STORAGE_ACCESS_KEY_ID="your-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="comet-comics"

# Public storage endpoint used in the CSP connect-src allowlist
NEXT_PUBLIC_AWS_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

